{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seml0.invalid/cidr/p10/observation-row.schema.json",
  "title": "CIDR P10/P11 query-observations.tsv row after TSV decoding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "system_id",
    "group",
    "repeat_index",
    "phase",
    "pass_index",
    "query_index",
    "edge_type",
    "src",
    "expected_count",
    "actual_count",
    "expected_sum_hash",
    "actual_sum_hash",
    "expected_xor_hash",
    "actual_xor_hash",
    "status",
    "latency_ns"
  ],
  "properties": {
    "contract_version": {"const": "cidr-typed-neighbor-adapter-v1"},
    "system_id": {"type": "string", "minLength": 1},
    "group": {"enum": ["embedded", "client-server"]},
    "repeat_index": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "phase": {"enum": ["warmup", "measured"]},
    "pass_index": {"type": "string", "pattern": "^[0-9]+$"},
    "query_index": {"type": "string", "pattern": "^[0-9]+$"},
    "edge_type": {"type": "string", "pattern": "^-?[0-9]+$"},
    "src": {"type": "string", "pattern": "^-?[0-9]+$"},
    "expected_count": {"type": "string", "pattern": "^[0-9]+$"},
    "actual_count": {"type": "string", "pattern": "^$|^[0-9]+$"},
    "expected_sum_hash": {"type": "string", "pattern": "^[0-9]+$"},
    "actual_sum_hash": {"type": "string", "pattern": "^$|^[0-9]+$"},
    "expected_xor_hash": {"type": "string", "pattern": "^[0-9]+$"},
    "actual_xor_hash": {"type": "string", "pattern": "^$|^[0-9]+$"},
    "status": {"enum": ["ok", "timeout"]},
    "latency_ns": {"type": "string", "pattern": "^[1-9][0-9]*$"}
  }
}
